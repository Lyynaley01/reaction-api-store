PORT=3000
PUBLIC_URL=https://api.domain-lo.com

# Ganti dengan domain frontend/backend Anda.
CORS_ORIGIN=https://api.domain-lo.com

# Admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# JWT
JWT_SECRET=change-this-to-a-long-random-secret

# Upstream ZXC — JANGAN taruh key ini di frontend.
ZXC_API_URL=https://auto-reaction.zxcoderid.web.id/api/vip/open-api/react
ZXC_API_KEY=CHANGE_ME

# Harga dasar: Rp5.000 / 100 coin
COIN_UNIT=100
COIN_UNIT_PRICE=5000

# Upload bukti pembayaran manual
MAX_UPLOAD_MB=5
